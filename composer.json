{
    "name": "team-blue/php-exception",
    "type": "library",
    "description": "PHP Exception library",
    "license": "MIT",
    "authors": [
        {
            "name": "Arne De Smedt",
            "email": "arnedesmdt@gmail.com",
            "homepage": "https://github.com/arnedesmedt"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3",
        "api-platform/core": "^3.0",
        "arnedesmedt/event-engine-symfony-bundle": "^0.7.14",
        "arnedesmedt/json-immutable-objects": "~0.1",
        "arnedesmedt/php-util": "~0.1",
        "arnedesmedt/specifications": "^0.2.5",
        "event-engine/php-json-schema": "~3.0",
        "sentry/sentry": "^4.9",
        "symfony/error-handler": "^7.1",
        "symfony/http-kernel": "~6.0 || ~7.0",
        "symfony/serializer": "^7.1",
        "team-blue/common": "^0.5.64"
    },
    "require-dev" : {
        "doctrine/coding-standard": "~12.0",
        "phpmd/phpmd": "~2.0",
        "phpro/grumphp": "~2.0",
        "phpstan/phpstan": "~1.0",
        "phpunit/phpunit": "~11.0",
        "rector/rector": "~1.0",
        "squizlabs/php_codesniffer": "~3.0"
    },
    "autoload": {
        "psr-4": {
            "TeamBlue\\Exception\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TeamBlue\\Exception\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        },
        "sort-packages": true
    },
    "repositories": {
        "packeton.teamblue-ops.net": {
            "type": "composer",
            "url": "https://packeton.teamblue-ops.net"
        },
        "gitlab.group.team.blue/paas/clients": {
            "type": "composer",
            "url": "https://gitlab.group.team.blue/api/v4/group/3988/-/packages/composer/packages.json"
        }
    },
    "scripts-descriptions": {
        "tests": "Run all tests"
    },
    "scripts": {
        "tests": [
            "vendor/bin/phpcbf",
            "vendor/bin/phpcs",
            "vendor/bin/phpstan analyze --no-progress",
            "vendor/bin/phpmd src text phpmd.xml",
            "vendor/bin/phpmd tests text phpmd-tests.xml",
            "vendor/bin/rector --dry-run --no-progress-bar",
            "vendor/bin/phpunit"
        ]
    }
}
